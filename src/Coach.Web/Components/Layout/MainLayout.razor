@inherits LayoutComponentBase
@implements IDisposable
@using Coach.Application.Models
@using Coach.Application.Services
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Nav
@inject CoachPersonaRegistry Registry

<div class="flex h-screen flex-col bg-slate-50">
    <header class="border-b border-slate-200 bg-white">
        <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3 sm:px-6">
            <div class="flex items-center gap-2">
                <a href="/" class="flex items-center gap-2">
                    <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-900 text-sm font-bold text-white">C</span>
                    <span class="text-base font-semibold text-slate-900">Coach</span>
                </a>
                @if (_persona is not null)
                {
                    <a
                        href="/"
                        title="Switch coach"
                        class="rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700 transition hover:bg-indigo-100">
                        @_persona.ShortName
                    </a>
                }
            </div>
            @if (_persona is not null)
            {
                <nav class="flex items-center gap-1 text-sm font-medium">
                    <NavLink
                        href="@_persona.Slug"
                        Match="NavLinkMatch.All"
                        class="rounded-full px-3 py-1.5 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900"
                        ActiveClass="bg-slate-900! text-white! hover:bg-slate-900!">
                        Chat
                    </NavLink>
                    <NavLink
                        href="@($"{_persona.Slug}/goals")"
                        class="rounded-full px-3 py-1.5 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900"
                        ActiveClass="bg-slate-900! text-white! hover:bg-slate-900!">
                        Goals
                    </NavLink>
                    <NavLink
                        href="@($"{_persona.Slug}/reflections")"
                        class="rounded-full px-3 py-1.5 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900"
                        ActiveClass="bg-slate-900! text-white! hover:bg-slate-900!">
                        Reflections
                    </NavLink>
                </nav>
            }
        </div>
    </header>

    <main class="flex min-h-0 flex-1 flex-col">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private CoachPersona? _persona;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        ResolvePersona();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ResolvePersona();
        StateHasChanged();
    }

    // MainLayout isn't a routed component, so it reads the active coach from the URL rather than a
    // route parameter (unlike CoachScopedPage). The coach is the first path segment
    // (/health/goals -> "health"); the picker at "/" and any unknown slug resolve to null, which
    // hides the pill and the nav.
    private void ResolvePersona()
    {
        var firstSegment = new Uri(Nav.Uri).AbsolutePath.Trim('/').Split('/', 2)[0];
        _persona = Registry.TryGet(firstSegment, out var persona) ? persona : null;
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
