@* Dismissible error banner. Render it behind a call-site `@if (error is not null)` guard (not an
   always-on binding): Blazor then creates a fresh DOM node per error, so Alpine's `show` resets to
   true and a previously-dismissed banner reappears. `MarginClass` places it for its context --
   `mb-3` when it sits above an input row, `mt-4` when it sits below a page header. *@
<div
    class="flex items-start justify-between gap-3 rounded-xl border border-red-200 bg-red-50 px-4 py-2.5 text-sm text-red-700 @MarginClass"
    x-data="{ show: true }"
    x-show="show"
    x-transition>
    <span>@Message</span>
    <button type="button" class="shrink-0 font-medium text-red-700/70 hover:text-red-900" x-on:click="show = false">✕</button>
</div>

@code {
    [Parameter, EditorRequired]
    public string? Message { get; set; }

    [Parameter]
    public string MarginClass { get; set; } = string.Empty;
}
