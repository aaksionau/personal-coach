@page "/reflections"
@rendermode InteractiveServer
@implements IDisposable
@using Coach.Application.Services
@using Coach.Domain.Entities
@inject ReflectionService ReflectionService

<PageTitle>Coach - Reflections</PageTitle>

<div class="min-h-0 flex-1 overflow-y-auto">
    <div class="mx-auto w-full max-w-3xl px-4 py-6 sm:px-6">
        <h1 class="text-xl font-semibold text-slate-900">Reflections</h1>
        <p class="mt-1 text-sm text-slate-500">
            Insights and themes your career coach has noted from your check-ins over time. New reflections
            are captured in chat &mdash; this is the record.
        </p>

        @if (_busy.Error is not null)
        {
            <div
                class="mt-4 flex items-start justify-between gap-3 rounded-xl border border-red-200 bg-red-50 px-4 py-2.5 text-sm text-red-700"
                x-data="{ show: true }"
                x-show="show"
                x-transition>
                <span>@_busy.Error</span>
                <button type="button" class="shrink-0 font-medium text-red-700/70 hover:text-red-900" x-on:click="show = false">✕</button>
            </div>
        }

        @if (_reflections is null)
        {
            <p class="mt-6 text-sm text-slate-500">Loading reflections...</p>
        }
        else if (_reflections.Count == 0)
        {
            <div class="mt-10 flex flex-col items-center rounded-2xl border border-dashed border-slate-300 py-12 text-center">
                <p class="font-medium text-slate-700">No reflections yet</p>
                <p class="mt-1 text-sm text-slate-500">As you check in with your coach, reflections it records will show up here.</p>
            </div>
        }
        else
        {
            <ol class="mt-6 space-y-4">
                @foreach (var reflection in _reflections)
                {
                    <li class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm" @key="reflection.Id">
                        <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                            @reflection.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")
                        </p>
                        <p class="mt-1.5 whitespace-pre-wrap text-sm text-slate-800">@reflection.Content</p>
                    </li>
                }
            </ol>
        }
    </div>
</div>

@code {
    private const string CoachSlug = "career";
    private const int MaxReflections = 100;

    private readonly CancellationTokenSource _cts = new();
    private readonly BusyState _busy = new();

    private IReadOnlyList<Reflection>? _reflections;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _reflections = await ReflectionService.GetRecentReflectionsAsync(CoachSlug, MaxReflections, _cts.Token);
        }
        catch (Exception ex)
        {
            _reflections = [];
            _busy.Error = $"Couldn't load reflections: {ex.Message}";
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
