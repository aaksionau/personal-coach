@page "/values"
@rendermode InteractiveServer
@using Coach.Application.Services
@using Coach.Domain.Entities
@inject ValuesProfileService ValuesProfileService

<PageTitle>Coach - Values Profile</PageTitle>

<div class="min-h-0 flex-1 overflow-y-auto">
    <div class="mx-auto w-full max-w-3xl px-4 py-6 sm:px-6">
        <h1 class="text-xl font-semibold text-slate-900">Values Profile</h1>
        <p class="mt-1 text-sm text-slate-500">
            The foundation every coach builds on. Set it up once through a guided conversation, then
            edit it here whenever your priorities change.
        </p>

        @if (_busy.Error is not null)
        {
            <ErrorBanner Message="@_busy.Error" MarginClass="mt-4" />
        }

        @if (_loading)
        {
            <p class="mt-6 text-sm text-slate-500">Loading your values profile...</p>
        }
        else if (_profile is null)
        {
            <div class="mt-10 flex flex-col items-center rounded-2xl border border-dashed border-slate-300 py-12 text-center">
                <p class="font-medium text-slate-700">No values profile yet</p>
                <p class="mt-1 max-w-sm text-sm text-slate-500">
                    A short guided conversation will help distil what matters to you into a summary
                    every coach can use.
                </p>
                <a
                    href="values/wizard"
                    class="mt-5 rounded-full bg-slate-900 px-5 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-slate-800">
                    Start the guided setup
                </a>
            </div>
        }
        else if (_editing)
        {
            <div class="mt-6 space-y-3">
                <textarea
                    class="min-h-[16rem] w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm leading-relaxed shadow-sm outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-200"
                    @bind="_draft"
                    @bind:event="oninput"
                    disabled="@_busy.Busy"></textarea>
                <div class="flex gap-2">
                    <button
                        type="button"
                        class="rounded-full bg-slate-900 px-5 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-slate-800 disabled:opacity-50"
                        disabled="@(_busy.Busy || string.IsNullOrWhiteSpace(_draft))"
                        @onclick="SaveAsync">
                        Save
                    </button>
                    <button
                        type="button"
                        class="rounded-full border border-slate-300 px-5 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100 disabled:opacity-50"
                        disabled="@_busy.Busy"
                        @onclick="CancelEdit">
                        Cancel
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <p class="whitespace-pre-wrap text-sm leading-relaxed text-slate-800">@_profile.Content</p>
            </div>
            <div class="mt-3 flex items-center justify-between">
                <p class="text-xs text-slate-400">
                    Last updated @_profile.UpdatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")
                </p>
                <div class="flex gap-3 text-sm font-medium">
                    <button type="button" class="text-slate-600 transition hover:text-slate-900" @onclick="StartEdit">
                        Edit
                    </button>
                    <a href="values/wizard" class="text-slate-500 transition hover:text-slate-800">Redo guided setup</a>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private readonly BusyState _busy = new();

    private ValuesProfile? _profile;
    private bool _loading = true;
    private bool _editing;
    private string _draft = string.Empty;

    // Cheap single-row reads/writes -- not worth a CancellationTokenSource; a dropped circuit just
    // discards the result. (The wizard page keeps one because its model call is expensive to leave running.)
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _profile = await ValuesProfileService.GetProfileAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            _busy.Error = $"Couldn't load your values profile: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void StartEdit()
    {
        _draft = _profile?.Content ?? string.Empty;
        _editing = true;
        _busy.Error = null;
    }

    private void CancelEdit() => _editing = false;

    private Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_draft) || _busy.Busy)
        {
            return Task.CompletedTask;
        }

        return _busy.RunAsync(
            async () =>
            {
                _profile = await ValuesProfileService.SaveProfileAsync(_draft, CancellationToken.None);
                _editing = false;
            },
            ex => $"Couldn't save your values profile: {ex.Message}");
    }
}
