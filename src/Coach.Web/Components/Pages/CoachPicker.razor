@page "/"
@using Coach.Application.Services
@inject CoachPersonaRegistry Registry

<PageTitle>Coach</PageTitle>

<div class="min-h-0 flex-1 overflow-y-auto">
    <div class="mx-auto w-full max-w-3xl px-4 py-6 sm:px-6">
        <h1 class="text-xl font-semibold text-slate-900">Your coaches</h1>
        <p class="mt-1 text-sm text-slate-500">Pick a coach to start a conversation. Each one keeps its own chat, goals, and reflections.</p>

        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
            @foreach (var persona in Registry.GetAll())
            {
                <a
                    href="@persona.Slug"
                    class="flex items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-slate-300 hover:shadow"
                    @key="persona.Slug">
                    <h2 class="font-semibold text-slate-900">@persona.Name</h2>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 shrink-0 text-slate-400">
                        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                    </svg>
                </a>
            }
        </div>

        <a
            href="/values"
            class="mt-4 flex items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-slate-300 hover:shadow">
            <div class="min-w-0">
                <h2 class="font-semibold text-slate-900">Values profile</h2>
                <p class="mt-0.5 text-sm text-slate-500">The foundation every coach builds on.</p>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 shrink-0 text-slate-400">
                <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
            </svg>
        </a>
    </div>
</div>
