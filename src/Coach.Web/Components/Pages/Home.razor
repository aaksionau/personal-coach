@page "/"
@using Npgsql
@inject NpgsqlDataSource DataSource

<PageTitle>Coach</PageTitle>

<div class="mx-auto max-w-2xl px-6 py-12">
    <h1 class="text-3xl font-bold text-slate-900">Personal Coach</h1>
    <p class="mt-2 text-slate-600">Deployment skeleton is up and reachable.</p>

    <section class="mt-8 rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Postgres</h2>
        @if (_dbConnected is null)
        {
            <p class="mt-1 text-slate-600">Checking...</p>
        }
        else if (_dbConnected == true)
        {
            <p class="mt-1 font-medium text-emerald-700">Connected</p>
        }
        else
        {
            <p class="mt-1 font-medium text-red-700">Connection failed: @_dbError</p>
        }
    </section>

    <section class="mt-6 rounded-lg border border-slate-200 bg-white p-4 shadow-sm" x-data="{ open: false }">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Alpine.js</h2>
        <button
            type="button"
            class="mt-2 rounded bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700"
            x-on:click="open = !open">
            Toggle
        </button>
        <p class="mt-2 text-slate-600" x-show="open" x-cloak>
            Alpine.js is wired up and handling this without a server round-trip.
        </p>
    </section>
</div>

@code {
    private bool? _dbConnected;
    private string? _dbError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var connection = await DataSource.OpenConnectionAsync();
            await using var command = new NpgsqlCommand("SELECT 1", connection);
            await command.ExecuteScalarAsync();
            _dbConnected = true;
        }
        catch (Exception ex)
        {
            _dbConnected = false;
            _dbError = ex.Message;
        }
    }
}
