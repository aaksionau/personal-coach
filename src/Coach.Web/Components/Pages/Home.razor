@page "/{CoachSlug}"
@rendermode InteractiveServer
@inherits CoachScopedPage
@using Coach.Application.Interfaces
@using Coach.Application.Services
@using Coach.Domain.Entities
@using Coach.Domain.Enums
@inject CoachConversationEngine ConversationEngine
@inject IChatMessageStore ChatMessageStore

<PageTitle>Coach - @(Persona?.ShortName) Chat</PageTitle>

<div class="mx-auto flex min-h-0 w-full max-w-3xl flex-1 flex-col px-4 sm:px-6">
    <div class="min-h-0 flex-1 space-y-3 overflow-y-auto py-4">
        @if (_messages is null)
        {
            <p class="text-sm text-slate-500">Loading conversation...</p>
        }
        else if (_messages.Count == 0)
        {
            <div class="flex h-full flex-col items-center justify-center py-16 text-center">
                <p class="text-lg font-medium text-slate-700">Say hello to get started</p>
                <p class="mt-1 text-sm text-slate-500">Your @(Persona?.ShortName) coach is ready when you are.</p>
            </div>
        }
        else
        {
            @foreach (var message in _messages)
            {
                <ChatBubble IsUser="message.Role == ChatMessageRole.User" Content="message.Content" @key="message.Id" />
            }
        }
        @if (_pendingUserMessage is not null)
        {
            <ChatBubble IsUser="true" Content="_pendingUserMessage" Pending="true" />
        }
    </div>

    @if (_busy.Error is not null)
    {
        <div
            class="mb-3 flex items-start justify-between gap-3 rounded-xl border border-red-200 bg-red-50 px-4 py-2.5 text-sm text-red-700"
            x-data="{ show: true }"
            x-show="show"
            x-transition>
            <span>@_busy.Error</span>
            <button type="button" class="shrink-0 font-medium text-red-700/70 hover:text-red-900" x-on:click="show = false">✕</button>
        </div>
    }

    <form class="flex gap-2 border-t border-slate-200 py-3" @onsubmit="SendAsync">
        <input
            class="min-w-0 flex-1 rounded-full border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-200"
            @bind="_draft"
            @bind:event="oninput"
            placeholder="Message your @(Persona?.ShortName) coach..."
            disabled="@_busy.Busy" />
        <button
            type="submit"
            class="shrink-0 rounded-full bg-slate-900 px-5 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-slate-800 disabled:opacity-50"
            disabled="@(_busy.Busy || string.IsNullOrWhiteSpace(_draft))">
            Send
        </button>
    </form>
</div>

@code {
    private readonly BusyState _busy = new();

    private List<ChatMessage>? _messages;
    private string _draft = string.Empty;
    private string? _pendingUserMessage;

    protected override async Task OnCoachChangedAsync()
    {
        _messages = null;
        _draft = string.Empty;
        _pendingUserMessage = null;
        _busy.Error = null;

        try
        {
            var history = await ChatMessageStore.GetRecentAsync(CoachSlug, 50, CancellationToken);
            _messages = history.ToList();
        }
        catch (Exception ex)
        {
            _messages = [];
            _busy.Error = $"Couldn't load conversation history: {ex.Message}";
        }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_draft) || _busy.Busy)
        {
            return;
        }

        var userMessage = _draft;
        _draft = string.Empty;
        _pendingUserMessage = userMessage;

        await _busy.RunAsync(
            async () =>
            {
                var turn = await ConversationEngine.SendMessageAsync(CoachSlug, userMessage, CancellationToken);
                _messages!.Add(turn.UserMessage);
                _messages.Add(turn.AssistantMessage);
            },
            ex =>
            {
                _draft = userMessage;
                return $"Coach didn't reply: {ex.Message}";
            });

        _pendingUserMessage = null;
    }
}
