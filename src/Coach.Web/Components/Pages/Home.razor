@page "/"
@rendermode InteractiveServer
@inherits BusyComponentBase
@implements IDisposable
@using Coach.Application.Interfaces
@using Coach.Application.Services
@using Coach.Domain.Entities
@using Coach.Domain.Enums
@inject CoachConversationEngine ConversationEngine
@inject IChatMessageStore ChatMessageStore

<PageTitle>Coach - Chat</PageTitle>

<div class="mx-auto flex min-h-0 w-full max-w-3xl flex-1 flex-col px-4 sm:px-6">
    <div class="min-h-0 flex-1 space-y-3 overflow-y-auto py-4">
        @if (_messages is null)
        {
            <p class="text-sm text-slate-500">Loading conversation...</p>
        }
        else if (_messages.Count == 0)
        {
            <div class="flex h-full flex-col items-center justify-center py-16 text-center">
                <p class="text-lg font-medium text-slate-700">Say hello to get started</p>
                <p class="mt-1 text-sm text-slate-500">Your career coach is ready when you are.</p>
            </div>
        }
        else
        {
            @foreach (var message in _messages)
            {
                <div class="flex @(message.Role == ChatMessageRole.User ? "justify-end" : "justify-start")" @key="message.Id">
                    <div class="@(message.Role == ChatMessageRole.User
                        ? "max-w-[85%] rounded-2xl rounded-br-sm bg-slate-900 px-4 py-2.5 text-white shadow-sm sm:max-w-[75%]"
                        : "max-w-[85%] rounded-2xl rounded-bl-sm border border-slate-200 bg-white px-4 py-2.5 text-slate-800 shadow-sm sm:max-w-[75%]")">
                        <p class="whitespace-pre-wrap text-sm leading-relaxed">@message.Content</p>
                    </div>
                </div>
            }
        }
        @if (_pendingUserMessage is not null)
        {
            <div class="flex justify-end">
                <div class="max-w-[85%] rounded-2xl rounded-br-sm bg-slate-900 px-4 py-2.5 text-white opacity-60 shadow-sm sm:max-w-[75%]">
                    <p class="whitespace-pre-wrap text-sm leading-relaxed">@_pendingUserMessage</p>
                </div>
            </div>
        }
    </div>

    @if (Error is not null)
    {
        <div
            class="mb-3 flex items-start justify-between gap-3 rounded-xl border border-red-200 bg-red-50 px-4 py-2.5 text-sm text-red-700"
            x-data="{ show: true }"
            x-show="show"
            x-transition>
            <span>@Error</span>
            <button type="button" class="shrink-0 font-medium text-red-700/70 hover:text-red-900" x-on:click="show = false">✕</button>
        </div>
    }

    <form class="flex gap-2 border-t border-slate-200 py-3" @onsubmit="SendAsync">
        <input
            class="min-w-0 flex-1 rounded-full border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-200"
            @bind="_draft"
            @bind:event="oninput"
            placeholder="Message your career coach..."
            disabled="@Busy" />
        <button
            type="submit"
            class="shrink-0 rounded-full bg-slate-900 px-5 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-slate-800 disabled:opacity-50"
            disabled="@(Busy || string.IsNullOrWhiteSpace(_draft))">
            Send
        </button>
    </form>
</div>

@code {
    private const string CoachSlug = "career";

    private readonly CancellationTokenSource _cts = new();

    private List<ChatMessage>? _messages;
    private string _draft = string.Empty;
    private string? _pendingUserMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var history = await ChatMessageStore.GetRecentAsync(CoachSlug, 50, _cts.Token);
            _messages = history.ToList();
        }
        catch (Exception ex)
        {
            _messages = [];
            Error = $"Couldn't load conversation history: {ex.Message}";
        }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_draft) || Busy)
        {
            return;
        }

        var userMessage = _draft;
        _draft = string.Empty;
        _pendingUserMessage = userMessage;

        try
        {
            await RunBusyAsync(
                async () =>
                {
                    var turn = await ConversationEngine.SendMessageAsync(CoachSlug, userMessage, _cts.Token);
                    _messages!.Add(turn.UserMessage);
                    _messages.Add(turn.AssistantMessage);
                },
                ex =>
                {
                    _draft = userMessage;
                    return $"Coach didn't reply: {ex.Message}";
                });
        }
        finally
        {
            _pendingUserMessage = null;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
